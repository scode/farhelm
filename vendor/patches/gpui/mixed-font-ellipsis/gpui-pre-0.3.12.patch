+/// Fit an end ellipsis in the same fonts and decoration runs the text will be painted with.
+///
+/// The full line's shaped glyph positions give an initial cut without walking the whole input again. At a
+/// font or direction boundary the affix can inherit another face and the prefix can shape differently, so
+/// only accept a candidate after measuring the complete string that will actually be drawn.
+fn fit_mixed_font_ellipsis(
+    line: &WrappedLine,
+    text_system: &WindowTextSystem,
+    width: Pixels,
+    font_size: Pixels,
+    affix: &str,
+    runs: &[TextRun],
+) -> (SharedString, Vec<TextRun>) {
+    let measure = |(text, runs): &(SharedString, Vec<TextRun>)| {
+        if text.is_empty() {
+            return Some(crate::px(0.));
+        }
+        text_system
+            .shape_text(text.clone(), font_size, runs, None, None)
+            .log_err()?
+            .first()
+            .map(|line| line.unwrapped_layout.width)
+    };
+    let mut best = line_end_candidate(&line.text, 0, affix, runs);
+    let Some(affix_width) = measure(&best).filter(|measured| *measured <= width) else {
+        return ("".into(), Vec::new());
+    };
+
+    // A visual position gives a useful byte offset only when glyphs stay in logical order. RTL runs can map the
+    // far end of a run to its first byte, so search logical prefixes in that case.
+    let layout = &line.unwrapped_layout;
+    let mut high = line.text.len().saturating_sub(1);
+    if layout
+        .runs
+        .iter()
+        .flat_map(|run| run.glyphs.iter().map(|glyph| glyph.index))
+        .is_sorted()
+        && let Some(seed) = layout.index_for_x(width - affix_width)
+    {
+        let candidate = line_end_candidate(&line.text, seed, affix, runs);
+        if measure(&candidate).is_some_and(|measured| measured <= width) {
+            return candidate;
+        }
+        high = seed.saturating_sub(1);
+    }
+
+    // Search bytes with character-boundary cuts. A multibyte character at a midpoint cannot stall the search.
+    let mut low = 1;
+    while low <= high {
+        let mid = low + (high - low) / 2;
+        let end = line.text.floor_char_boundary(mid);
+        let candidate = line_end_candidate(&line.text, end, affix, runs);
+        if measure(&candidate).is_some_and(|measured| measured <= width) {
+            best = candidate;
+            low = mid + 1;
+        } else {
+            high = mid - 1;
+        }
+    }
+    best
+}

+/// Native position before logical layout translation; these domains are distinct.
+///
+/// XKB names follow the active keymap's canonical position naming (for example
+/// AE01 and KP1). Mac codes are NSEvent virtual keycodes, not DOM keyCodes.
+/// Consumers must explicitly map supported positions and leave unknown ones unknown.
+#[derive(Clone, Debug, Eq, PartialEq, Hash)]
+pub enum NativeKeyIdentity {
+    /// Canonical name from the active XKB keymap; numeric codes are keymap-specific.
+    Xkb(SharedString),
+    /// NSEvent virtual keycode, independent of the character a layout produces.
+    Mac(u16),
+}
+
+/// Native facts lost by logical keystroke normalization, independent of bindings.
+///
+/// Shift is the original event state, including symbol keys whose Keystroke
+/// modifier is cleared. This record neither identifies an IME commit nor changes
+/// Keystroke matching. Its absence means unavailable, including synthetic input.
+#[derive(Clone, Debug, Eq, PartialEq, Hash)]
+pub struct NativeKey {
+    /// Native position in its platform domain, without a guessed DOM conversion.
+    pub identity: NativeKeyIdentity,
+    /// Shift at this event, before symbols remove it from the logical Keystroke.
+    pub shift: bool,
+}
+

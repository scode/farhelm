+#[cfg(any(feature = "wayland", feature = "x11"))]
+/// Preserve native position and Shift before logical labels or compose erase them.
+/// Keycodes without a name in the active keymap yield None. Consumers must
+/// treat unrecognised names as unknown rather than guessing from logical text.
+pub(super) fn native_key_from_xkb(
+    state: &State,
+    modifiers: gpui::Modifiers,
+    keycode: Keycode,
+) -> Option<gpui::NativeKey> {
+    let keymap = state.get_keymap();
+    Some(gpui::NativeKey {
+        identity: gpui::NativeKeyIdentity::Xkb(keymap.key_get_name(keycode)?.to_owned().into()),
+        shift: modifiers.shift,
+    })
+}

+    /// Real XKB conversion keeps the NumLock keypad distinct after GPUI's logical
+    /// labels collide. This uses installed layout data, not a native window event.
+    #[cfg(any(feature = "wayland", feature = "x11"))]
+    #[test]
+    fn native_key_metadata_distinguishes_keypad_and_preserves_symbol_shift() {
+        let context = xkb::Context::new(xkb::CONTEXT_NO_ENVIRONMENT_NAMES);
+        let keymap = xkb::Keymap::new_from_names(
+            &context,
+            "evdev",
+            "pc105",
+            "us",
+            "",
+            Some(String::new()),
+            xkb::KEYMAP_COMPILE_NO_FLAGS,
+        )
+        .unwrap();
+        let mut state = xkb::State::new(&keymap);
+        let alt = 1 << keymap.mod_get_index("Mod1");
+        let numlock = 1 << keymap.mod_get_index("Mod2");
+        state.update_mask(alt, 0, numlock, 0, 0, 0);
+        let top = keymap.key_by_name("AE01").unwrap();
+        let pad = keymap.key_by_name("KP1").unwrap();
+        let modifiers = modifiers_from_xkb(&state);
+        assert_eq!(
+            keystroke_from_xkb(&state, modifiers, top),
+            keystroke_from_xkb(&state, modifiers, pad)
+        );
+        let top_native = native_key_from_xkb(&state, modifiers, top).unwrap();
+        let pad_native = native_key_from_xkb(&state, modifiers, pad).unwrap();
+        assert_eq!(
+            top_native.identity,
+            gpui::NativeKeyIdentity::Xkb("AE01".into())
+        );
+        assert_eq!(
+            pad_native.identity,
+            gpui::NativeKeyIdentity::Xkb("KP1".into())
+        );
+        assert_ne!(top_native, pad_native);
+
+        state.update_mask(1 << keymap.mod_get_index("Shift"), 0, 0, 0, 0, 0);
+        let equal = keymap.key_by_name("AE12").unwrap();
+        let modifiers = modifiers_from_xkb(&state);
+        let logical = keystroke_from_xkb(&state, modifiers, equal);
+        assert_eq!(logical.key, "+");
+        assert!(!logical.modifiers.shift);
+        assert!(native_key_from_xkb(&state, modifiers, equal).unwrap().shift);
+        assert!(native_key_from_xkb(&state, modifiers, Keycode::new(u32::MAX)).is_none());
+    }

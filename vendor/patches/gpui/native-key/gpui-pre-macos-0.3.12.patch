+/// Keep physical position and original Shift separate from layout/binding normalization.
+fn native_key(native_event: &NSEvent) -> gpui::NativeKey {
+    gpui::NativeKey {
+        identity: gpui::NativeKeyIdentity::Mac(native_event.keyCode()),
+        shift: native_event
+            .modifierFlags()
+            .contains(NSEventModifierFlags::Shift),
+    }
+}

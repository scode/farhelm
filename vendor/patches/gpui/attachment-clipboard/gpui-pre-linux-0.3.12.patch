+            return Task::ready(Ok(None));
+        };
+        if offer.has_mime_type(&self.self_mime) {
+            return Task::ready(Ok(self.contents.clone()));
+        }
+        let Some((mime, format)) = offer.payload_mime_type() else {
+            return Task::ready(Ok(None));

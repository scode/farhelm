+    /// Payload paste preserves file priority but chooses an offered image before
+    /// its accompanying text flavor. The synchronous editor API keeps its old
+    /// text-first behavior. An offered image that cannot be read is an error;
+    /// silently falling back to its label would pretend the image was pasted.
+    ///
+    /// Since 0.3.12 the board is a non-null objc2 `Retained`, so the 0.3.9 nil-board
+    /// `Unavailable` result no longer has a representation here.
+    pub fn read_payload(&self) -> Result<Option<ClipboardItem>, gpui::ClipboardReadError> {
+        #[expect(
+            deprecated,
+            reason = "Preserve the existing file-copy pasteboard format"
+        )]
+        let filenames = unsafe { self.inner.propertyListForType(NSFilenamesPboardType) };
+        if filenames
+            .as_ref()
+            .and_then(|filenames| filenames.downcast_ref::<NSArray>())
+            .is_some_and(|filenames| filenames.count() > 0)
+        {
+            return Ok(self.read());
+        }
+        let Some(types) = self.inner.types() else {
+            return Ok(None);
+        };
+        for format in ImageFormat::iter() {
+            let ut_type = UTType::from(format);
+            if types.containsObject(ut_type.inner()) {
+                return self
+                    .read_image(format)
+                    .map(Some)
+                    .ok_or(gpui::ClipboardReadError::UnsupportedContent);
+            }
+        }
+        Ok(self.read())
+    }

+    /// An external mixed offer must paste encoded image bytes rather than its
+    /// text label. The old editor read stays text-first; adding file references
+    /// to that same offer restores file priority for payload-oriented paste.
+    #[test]
+    #[ignore = "requires a logged-in macOS pasteboard service; run explicitly on the GUI desktop"]
+    fn attachment_clipboard_payload_priority_preserves_sync_behavior() {
+        autoreleasepool(|_| unsafe {
+            let pasteboard = Pasteboard::unique();
+            #[expect(
+                deprecated,
+                reason = "Preserve the existing file-copy pasteboard format"
+            )]
+            let types = NSArray::from_slice(&[
+                NSPasteboardTypePNG,
+                NSPasteboardTypeString,
+                NSFilenamesPboardType,
+            ]);
+            pasteboard.inner.declareTypes_owner(&types, None);
+            let bytes = [1u8, 2, 3];
+            let data = NSData::with_bytes(&bytes);
+            pasteboard
+                .inner
+                .setData_forType(Some(&data), NSPasteboardTypePNG);
+            let text = NSData::with_bytes(b"image label");
+            pasteboard
+                .inner
+                .setData_forType(Some(&text), NSPasteboardTypeString);
+            assert!(
+                matches!(pasteboard.read().unwrap().entries.as_slice(), [ClipboardEntry::String(string)] if string.text == "image label")
+            );
+            assert!(
+                matches!(pasteboard.read_payload().unwrap().unwrap().entries.as_slice(), [ClipboardEntry::Image(image)] if image.format == ImageFormat::Png && image.bytes == bytes)
+            );
+            let paths =
+                NSArray::from_retained_slice(&[NSString::from_str("/file with spaces.png")]);
+            #[expect(
+                deprecated,
+                reason = "Preserve the existing file-copy pasteboard format"
+            )]
+            pasteboard
+                .inner
+                .setPropertyList_forType(&paths, NSFilenamesPboardType);
+            assert!(
+                matches!(pasteboard.read_payload().unwrap().unwrap().entries.first(), Some(ClipboardEntry::ExternalPaths(paths)) if paths.0.as_slice() == [PathBuf::from("/file with spaces.png")])
+            );
+        });
+    }

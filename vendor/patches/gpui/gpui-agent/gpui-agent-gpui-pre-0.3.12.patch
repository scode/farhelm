diff --git a/gpui/gpui-agent/src/lib.rs b/gpui/gpui-agent/src/lib.rs
index bc373db..5c29248 100644
--- a/gpui/gpui-agent/src/lib.rs
+++ b/gpui/gpui-agent/src/lib.rs
@@ -3,10 +3,22 @@
 //! Call [`init`] once at startup. It does nothing unless the app was started with
 //! `GPUI_AGENT_SOCKET` set, which `gpui-agent launch` does.
 
-#[cfg(all(feature = "zed", feature = "gpui-pre-0-3-9"))]
-compile_error!("gpui-agent builds against one GPUI: enable `zed` or `gpui-pre-0-3-9`, not both");
-#[cfg(not(any(feature = "zed", feature = "gpui-pre-0-3-9")))]
-compile_error!("gpui-agent needs a GPUI: enable the `zed` or `gpui-pre-0-3-9` feature");
+#[cfg(any(
+    all(feature = "zed", feature = "gpui-pre-0-3-9"),
+    all(feature = "zed", feature = "gpui-pre-0-3-12"),
+    all(feature = "gpui-pre-0-3-9", feature = "gpui-pre-0-3-12")
+))]
+compile_error!(
+    "gpui-agent builds against one GPUI: enable one of `zed`, `gpui-pre-0-3-9`, `gpui-pre-0-3-12`"
+);
+#[cfg(not(any(
+    feature = "zed",
+    feature = "gpui-pre-0-3-9",
+    feature = "gpui-pre-0-3-12"
+)))]
+compile_error!(
+    "gpui-agent needs a GPUI: enable the `zed`, `gpui-pre-0-3-9` or `gpui-pre-0-3-12` feature"
+);
 
 mod compat;
 

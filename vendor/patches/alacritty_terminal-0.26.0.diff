+        let mut term = fed_term(4, 2, 0, b"\x1b[?7labcd\x1b[?7h");
+        term.resize(TermSize::new(6, 2));
+        assert_eq!(cursor(&term), (0, 3, false));
+    }
+
+    /// Spec: CUU, CUD, CNL and CPL stop at the scroll region's margin in the
+    /// direction of travel when the cursor starts inside the region or beyond
+    /// that margin's far side, and at the screen's edge otherwise; in origin
+    /// mode they move relative to where the cursor is; a count far past the
+    /// screen's height stops at the edge.
+    ///
+    /// Why: that is what xterm (`CursorUp`, `CursorDown`) and tmux
+    /// (`screen_write_cursorup`, `screen_write_cursordown`) do, so programs
+    /// that move relative to the cursor inside a scroll region draw in the
+    /// right place; upstream ignored the margins, and in origin mode added the
+    /// region's offset to an absolute line (vendor/README.md).
+    #[test]
+    fn relative_vertical_moves_stop_at_the_scroll_margins() {
+        // (output on a 4x6 screen with lines 2 to 4 as the region, cursor
+        // line and column after it, counted from 0)
+        let cases: [(&[u8], i32, usize); 8] = [
+            (b"\x1b[3;2H\x1b[9A", 1, 1),
+            (b"\x1b[3;2H\x1b[9B", 3, 1),
+            (b"\x1b[1;2H\x1b[9B", 3, 1),
+            (b"\x1b[6;2H\x1b[9A", 1, 1),
+            (b"\x1b[1;2H\x1b[9A", 0, 1),
+            (b"\x1b[6;2H\x1b[9B", 5, 1),
+            (b"\x1b[3;2H\x1b[9E", 3, 0),
+            (b"\x1b[3;2H\x1b[9F", 1, 0),
+        ];
+        for (moves, line, column) in cases {
+            let mut bytes = b"\x1b[2;4r".to_vec();
+            bytes.extend_from_slice(moves);
+            let term = fed_term(4, 6, 0, &bytes);
+            let point = term.grid().cursor.point;
+            assert_eq!((point.line, point.column), (Line(line), Column(column)), "{moves:?}");
+        }
+        let term = fed_term(4, 6, 0, b"\x1b[2;4r\x1b[?6h\x1b[1B");
+        assert_eq!(term.grid().cursor.point.line, Line(2));
+
+        // Through the handler directly, a count far past the screen's height
+        // stops at the edge rather than overflowing the line.
+        let mut term = fed_term(4, 6, 0, b"\x1b[6;1H");
+        Handler::move_down(&mut term, usize::MAX);
+        assert_eq!(term.grid().cursor.point.line, Line(5));
+        Handler::move_up(&mut term, usize::MAX);
+        assert_eq!(term.grid().cursor.point.line, Line(0));
+    }
+
+    /// Spec: CHA (`CSI Ps G`) in origin mode moves the cursor along its own
+    /// line.
+    ///
+    /// Why: upstream's `goto_col` passed the cursor's absolute line to
+    /// `goto`, which in origin mode adds the region's offset again, so CHA
+    /// moved the cursor down; xterm (`CASE_HPA` with `CursorRow`) and tmux
+    /// (`INPUT_CSI_HPA`, which leaves the line alone) keep it on its line.
+    #[test]
+    fn cha_in_origin_mode_keeps_the_line() {
+        let term = fed_term(4, 6, 0, b"\x1b[2;4r\x1b[?6h\x1b[2;1H\x1b[3G");
+        let point = term.grid().cursor.point;
+        assert_eq!((point.line, point.column), (Line(2), Column(2)));
+    }
+
+    /// Spec: resetting origin mode (`CSI ? 6 l`) homes the cursor to the
+    /// screen's top left.
+    ///
+    /// Why: setting it homes the cursor and resetting it did not; xterm
+    /// (`srm_DECOM` in `dpmodes`) and tmux (`input_csi_dispatch_rm_private`,
+    /// mode 6) home it both ways.
+    #[test]
+    fn resetting_origin_mode_homes_the_cursor() {
+        let term = fed_term(4, 6, 0, b"\x1b[2;4r\x1b[?6h\x1b[2;2H\x1b[?6l");
+        let point = term.grid().cursor.point;
+        assert_eq!((point.line, point.column), (Line(0), Column(0)));
+    }
+
+    /// Spec: a cell keeps the first `MAX_ZEROWIDTH_CHARS` zero-width
+    /// characters printed onto it, in order, and drops the rest; the next
+    /// printable character still goes to the next cell.
+    ///
+    /// Why: without the cap one cell grows by four bytes per combining mark
+    /// for as long as a program keeps sending them.
+    #[test]
+    fn zerowidth_characters_per_cell_are_capped() {
+        let mut input = "e".to_owned();
+        for _ in 0..1000 {
+            input.push('\u{301}');
+        }
+        input.push('x');
+        let term = fed_term(10, 2, 0, input.as_bytes());
+
+        let base = &term.grid()[Line(0)][Column(0)];
+        assert_eq!(base.c, 'e');
+        assert_eq!(base.zerowidth(), Some(&['\u{301}'; cell::MAX_ZEROWIDTH_CHARS][..]));
+        assert_eq!(term.grid()[Line(0)][Column(1)].c, 'x');
+    }
+
+    /// Spec: an OSC 8 hyperlink whose URI is at most `MAX_HYPERLINK_URI_BYTES`
+    /// and whose `id` is at most `MAX_HYPERLINK_ID_BYTES` applies to the text
+    /// after it; one over either limit ends the active hyperlink, so the text
+    /// after it is unlinked rather than attributed to the previous link.
+    ///
+    /// Why: every cell holds its hyperlink, so the URI's length multiplies into
+    /// the grid's memory; and keeping the previous link active instead would
+    /// point text at a URI it never had.
+    #[test]
+    fn hyperlink_uri_and_id_lengths_are_capped() {
+        let uri_at = format!("http://e/{}", "u".repeat(MAX_HYPERLINK_URI_BYTES - 9));
+        let uri_over = format!("{uri_at}u");
+        let id_at = "i".repeat(MAX_HYPERLINK_ID_BYTES);
+        let id_over = format!("{id_at}i");
+
+        // (OSC 8 parameters, URI, whether the cell printed after it is linked)
+        let cases = [
+            (String::new(), &uri_at, true),
+            (String::new(), &uri_over, false),
+            (format!("id={id_at}"), &uri_at, true),
+            (format!("id={id_over}"), &uri_at, false),
+        ];
+        for (params, uri, linked) in cases {
+            let input = format!("\x1b]8;;http://prev\x07a\x1b]8;{params};{uri}\x07b");
+            let term = fed_term(10, 2, 0, input.as_bytes());
+
+            let prev = term.grid()[Line(0)][Column(0)].hyperlink().expect("first link applies");
+            assert_eq!(prev.uri(), "http://prev");
+            let cell = term.grid()[Line(0)][Column(1)].hyperlink();
+            assert_eq!(cell.as_ref().map(|link| link.uri()), linked.then_some(uri.as_str()));
+        }
+    }
+
+    /// Spec: an OSC 8 with the active link's explicit `id` and URI continues
+    /// that link, so the cells on both sides of it share one cell extra; an
+    /// OSC 8 with no `id`, or with another `id` or URI, starts a new link even
+    /// when an equal-looking one is active.
+    ///
+    /// Why: sharing is what keeps a program that repeats one link before
+    /// every character from costing a URI allocation per cell, and it must
+    /// not merge links that upstream (and xterm.js) keep apart, which would
+    /// change what a hover highlights.
+    #[test]
+    fn repeated_hyperlink_is_shared() {
+        let a = "\x1b]8;id=a;http://e/\x07";
+        // (the OSC 8 sent before each of two cells, whether the cells share it)
+        let cases = [
+            (a, a, true),
+            ("\x1b]8;;http://e/\x07", "\x1b]8;;http://e/\x07", false),
+            (a, "\x1b]8;id=b;http://e/\x07", false),
+            (a, "\x1b]8;id=a;http://f/\x07", false),
+        ];
+        for (first, second, shared) in cases {
+            let term = fed_term(10, 2, 0, format!("{first}x{second}y").as_bytes());
+
+            let cells = [&term.grid()[Line(0)][Column(0)], &term.grid()[Line(0)][Column(1)]];
+            let [x, y] = cells.map(|cell| cell.extra.as_ref().expect("cell is linked"));
+            assert_eq!(Arc::ptr_eq(x, y), shared, "{first:?} then {second:?}");
+            let links = cells.map(|cell| cell.hyperlink().expect("cell is linked"));
+            assert_eq!(links[0] == links[1], shared, "{first:?} then {second:?}");
+        }
+    }
+
+    /// Spec: hyperlinks are made only while the terminal's extra storage has
+    /// room for one and the cell extra that carries it (its `id` and URI
+    /// lengths plus `HYPERLINK_COST`, and `CELL_EXTRA_COST`), up to
+    /// `MAX_EXTRA_STORAGE_BYTES`; an OSC 8 past that ends the active link, and
+    /// the text after it is unlinked. Clearing the cells that hold links gives
+    /// their storage back, and links attach again.
+    ///
+    /// Why: the length caps bound one link, but a program that starts a new
+    /// link before every character would still give every cell its own,
+    /// several gigabytes over a full scrollback.
+    #[test]
+    fn hyperlinks_are_bounded_by_the_extra_storage() {
+        let uri = format!("http://e/{}", "u".repeat(MAX_HYPERLINK_URI_BYTES - 9));
+        let cost = |id: &str| id.len() + uri.len() + HYPERLINK_COST + CELL_EXTRA_COST;
+        let fits = MAX_EXTRA_STORAGE_BYTES / cost("00000");
+        let mut input = String::new();
+        for n in 0..fits + 10 {
+            input.push_str(&format!("\x1b]8;id={n:05};{uri}\x1b\\x"));
+        }
+        let lines = (fits + 10).div_ceil(100);
+        let mut term = fed_term(100, lines, 0, input.as_bytes());
+
+        // Every link and its extra cost the same, so exactly the first `fits`
+        // are made.
+        let linked = (0..fits + 10)
+            .map(|n| Point::new(Line((n / 100) as i32), Column(n % 100)))
+            .map(|point| term.grid()[point].hyperlink().is_some())
+            .collect::<Vec<_>>();
+        assert!(linked[..fits].iter().all(|&linked| linked));
+        assert!(linked[fits..].iter().all(|&linked| !linked));
+        assert_eq!(term.extra_storage().used(), fits * cost("00000"));
+
+        let mut parser: ansi::Processor = ansi::Processor::new();
+        parser.advance(&mut term, b"\x1b[H\x1b[2J");
+        assert_eq!(term.extra_storage().used(), 0, "clearing gives the storage back");
+        parser.advance(&mut term, format!("\x1b]8;id=new;{uri}\x1b\\y").as_bytes());
+        let link = term.grid()[Line(0)][Column(0)].hyperlink().expect("links attach again");
+        assert_eq!(link.id(), "new");
+        drop(link);
+        assert_eq!(term.extra_storage().used(), cost("new"));
+    }
+
+    /// Spec: a combining character, or an underline color, that needs a cell
+    /// extra the storage has no room for (`MAX_EXTRA_STORAGE_BYTES`, each
+    /// extra costing `CELL_EXTRA_COST`) is dropped, the color falling back to
+    /// the default; the cells before keep theirs, and clearing them makes
+    /// room again.
+    ///
+    /// Why: a combining mark or an underline color varied before every
+    /// character gives every cell an extra of its own, about 390 MiB over a
+    /// full scrollback, which one terminal must not be able to make the shared
+    /// supervisor hold.
+    #[test]
+    fn combining_characters_and_underline_colors_are_bounded() {
+        let fits = MAX_EXTRA_STORAGE_BYTES / CELL_EXTRA_COST;
+        let cells = fits + 10;
+        let lines = cells.div_ceil(1000);
+        let column = |n: usize| Point::new(Line((n / 1000) as i32), Column(n % 1000));
+
+        let term = fed_term(1000, lines, 0, "e\u{301}".repeat(cells).as_bytes());
+        let marked = |term: &Term<VoidListener>, n| term.grid()[column(n)].zerowidth().is_some();
+        assert!((0..fits).all(|n| marked(&term, n)));
+        assert!((fits..cells).all(|n| !marked(&term, n)));
+        assert_eq!(term.extra_storage().used(), fits * CELL_EXTRA_COST);
+
+        let colors: String = (0..cells).map(|n| format!("\x1b[58;5;{}mx", n % 256)).collect();
+        let mut term = fed_term(1000, lines, 0, colors.as_bytes());
+        let colored = |term: &Term<VoidListener>, n| term.grid()[column(n)].underline_color();
+        assert!((0..fits).all(|n| colored(&term, n) == Some(Color::Indexed((n % 256) as u8))));
+        assert!((fits + 1..cells).all(|n| colored(&term, n).is_none()));
+        assert!(term.extra_storage().used() <= MAX_EXTRA_STORAGE_BYTES);
+
+        let mut parser: ansi::Processor = ansi::Processor::new();
+        parser.advance(&mut term, b"\x1b[0m\x1b[H\x1b[2J\x1b[58;5;7mz");
+        assert_eq!(colored(&term, 0), Some(Color::Indexed(7)));
+        assert_eq!(term.extra_storage().used(), CELL_EXTRA_COST);
+    }
+
+    /// Spec: setting a cell's underline color or hyperlink to the value it
+    /// has already leaves its extra as it is, rather than copying it.
+    ///
+    /// Why: the cursor template's extra is shared with every cell printed
+    /// from it, so a program that repeats `SGR 59` (or `SGR 0`) before every
+    /// character while a link is active made a copy for every cell, past any
+    /// check for room.
+    #[test]
+    fn repeating_an_unchanged_attribute_copies_nothing() {
+        let input = format!("\x1b]8;id=a;http://e/\x1b\\{}", "\x1b[59m\x1b[0mx".repeat(1000));
+        let term = fed_term(100, 20, 0, input.as_bytes());
+        let one = "a".len() + "http://e/".len() + HYPERLINK_COST + CELL_EXTRA_COST;
+        assert_eq!(term.extra_storage().used(), one);
+    }
+
+    /// Spec: restoring a saved cursor whose template's extra is shared with
+    /// the cells printed from it, then removing an attribute from it, never
+    /// takes the extra storage past `MAX_EXTRA_STORAGE_BYTES`: once the
+    /// storage is full, the removal drops the template's whole extra.
+    ///
+    /// Why: each removal copies the shared extra, and a program repeating
+    /// `ESC 8`, `SGR 59`, print once per cell would otherwise give every cell
+    /// its own extra past any check (a review measured 122 MiB after 4,000
+    /// rows, growing linearly), the unbounded growth the storage exists to
+    /// prevent.
+    #[test]
+    fn restoring_a_saved_cursor_cannot_grow_the_storage_past_the_limit() {
+        let start = "\x1b]8;id=keep;http://k/\x1b\\\x1b[58;5;3m\x1b7\x1b[59m\x1b]8;;\x1b\\";
+        let row: String =
+            (1..=200).map(|column| format!("\x1b8\x1b[60;{column}H\x1b[59mx")).collect();
+        let mut input = start.to_owned();
+        let rows = MAX_EXTRA_STORAGE_BYTES / CELL_EXTRA_COST / 200 + 100;
+        for _ in 0..rows {
+            input.push_str(&row);
+            input.push_str("\x1b[60;1H\n");
+        }
+        let term = fed_term(200, 60, rows, input.as_bytes());
+        assert!(term.extra_storage().used() <= MAX_EXTRA_STORAGE_BYTES);
+        assert!(
+            term.extra_storage().used() > MAX_EXTRA_STORAGE_BYTES - 200 * CELL_EXTRA_COST,
+            "the loop filled the storage"
+        );
+    }
+
+    /// Spec: an alternate screen (which resizes without reflowing) cleared
+    /// with a background color, narrowed and widened again, and cleared with
+    /// the default background holds no cell of the old color.
+    ///
+    /// Why: a row reset skips the cells from `occ` on when its last cell has
+    /// the template's background, and growing a row used to append default
+    /// cells without counting the old ones, so the second clear left them
+    /// colored. Besides showing stale color, that made a terminal's state
+    /// depend on how its rows came to be, which a snapshot cannot reproduce.
+    #[test]
+    fn clearing_after_a_resize_clears_every_cell() {
+        let mut term = fed_term(10, 3, 0, b"\x1b[?1049h\x1b[44m\x1b[2J");
+        term.resize(TermSize::new(4, 3));
+        term.resize(TermSize::new(10, 3));
+        let mut parser: ansi::Processor = ansi::Processor::new();
+        parser.advance(&mut term, b"\x1b[0m\x1b[2J");
+        for line in 0..3 {
+            for column in 0..10 {
+                let cell = &term.grid()[Line(line)][Column(column)];
+                assert_eq!(cell.bg, Color::Named(NamedColor::Background), "{line},{column}");
+            }
+        }
+    }
+
+    /// Spec: a window title longer than `MAX_TITLE_BYTES` is cut to the
+    /// longest prefix that fits and ends on a character boundary; the title
+    /// stack keeps the cut title, and the `Event::Title` the listener gets
+    /// holds no more than the limit, in length or in capacity.
+    ///
+    /// Why: the parser accepts OSC payloads of up to 10 MiB for clipboard
+    /// writes, and the title stack holds 4096 entries, so uncut titles would
+    /// let one program pin tens of gigabytes; and a listener that keeps the
+    /// latest title would still hold the whole payload's allocation if only
+    /// the length were cut.
+    #[test]
+    fn title_length_is_capped() {
+        use std::cell::RefCell;
+        use std::rc::Rc;
+
+        /// Keeps the length and capacity of every title sent to it.
+        #[derive(Clone, Default)]
+        struct Titles(Rc<RefCell<Vec<(usize, usize)>>>);
+
+        impl EventListener for Titles {
+            fn send_event(&self, event: Event) {
+                if let Event::Title(title) = event {
+                    self.0.borrow_mut().push((title.len(), title.capacity()));
+                }
+            }
+        }
+
+        // Two-byte characters with one leading ASCII byte, so that the limit
+        // falls in the middle of a character.
+        let long = format!("x{}", "é".repeat(MAX_TITLE_BYTES));
+        let input = format!("\x1b]2;{long}\x07\x1b[22t");
+        let titles = Titles::default();
+        let mut term = Term::new(Config::default(), &TermSize::new(10, 2), titles.clone());
+        let mut parser: ansi::Processor = ansi::Processor::new();
+        parser.advance(&mut term, input.as_bytes());
+
+        let title = term.title().expect("title set");
+        assert_eq!(title.len(), MAX_TITLE_BYTES - 1);
+        assert!(long.starts_with(title));
+        assert_eq!(term.title_stack(), [Some(title.to_owned())]);
+        let events = titles.0.borrow().clone();
+        assert_eq!(events.len(), 1, "title events: {events:?}");
+        let (len, capacity) = events[0];
+        assert_eq!(len, MAX_TITLE_BYTES - 1);
+        assert!(capacity <= MAX_TITLE_BYTES, "the event's title keeps {capacity} bytes");
+
+        // A title at the limit is kept whole.
+        let exact = "t".repeat(MAX_TITLE_BYTES);
+        let term = fed_term(10, 2, 0, format!("\x1b]2;{exact}\x07").as_bytes());
+        assert_eq!(term.title(), Some(exact.as_str()));
+    }
+
+    /// Spec: `lines_scrolled_into_history` counts each line that scrolls off
+    /// the top of the primary screen, keeps counting once history is full, and
+    /// ignores scrolling inside a region that does not start at the top and
+    /// everything on the alternate screen; `history_clears` counts `CSI 3 J`
+    /// erasing history, and neither count goes down.
+    ///
+    /// Why: the grid stream sends history as appended ranges sized by the
+    /// first count and resynchronizes on the second; a miscount sends the
+    /// viewer wrong or duplicate history lines.
+    #[test]
+    fn history_counters() {
+        // Five lines: the first four newlines move the cursor down, the
+        // remaining sixteen each push one line into a three-line history.
+        let mut term = fed_term(10, 5, 3, &[b'\n'; 20]);
+        assert_eq!(term.grid().lines_scrolled_into_history(), 16);
+        assert_eq!(term.grid().history_size(), 3);
+
+        let mut parser: ansi::Processor = ansi::Processor::new();
+
+        // A scroll region that leaves the top line out keeps lines on screen.
+        // The marker printed on the region's last line moving up three lines
+        // shows that the region did scroll.
+        parser.advance(&mut term, b"\x1b[2;5r\x1b[5;1HR\n\n\n\x1b[r");
+        assert_eq!(term.grid()[Line(1)][Column(0)].c, 'R');
+        assert_eq!(term.grid().lines_scrolled_into_history(), 16);
+
+        // The alternate screen has no history; the primary's count is kept
+        // while it is hidden. The marker shows the alternate screen scrolled.
+        parser.advance(&mut term, b"\x1b[?1049h\x1b[5;1HA\n\n\n");
+        assert_eq!(term.grid()[Line(1)][Column(0)].c, 'A');
+        assert_eq!(term.grid().lines_scrolled_into_history(), 0);
+        assert_eq!(term.inactive_grid().lines_scrolled_into_history(), 16);
+        parser.advance(&mut term, b"\x1b[?1049l\x1b[5;1H\n");
+        assert_eq!(term.grid().lines_scrolled_into_history(), 17);
+
+        assert_eq!(term.grid().history_clears(), 0);
+        parser.advance(&mut term, b"\x1b[3J");
+        assert_eq!(term.grid().history_size(), 0);
+        assert_eq!(term.grid().history_clears(), 1);
+        assert_eq!(term.grid().lines_scrolled_into_history(), 17);
+    }
+
+    /// Spec: clearing the primary screen (`CSI 2 J`) counts the lines it
+    /// moves into history, up to the last one with content; a full reset
+    /// (`ESC c`) counts as a history erase, even with no history to erase,
+    /// and leaves `lines_scrolled_into_history` as it was.
+    ///
+    /// Why: both are things a program does on its own, so the embedder learns
+    /// of them only through these counters; `clear` in a shell is `CSI 2 J`,
+    /// and missing it would leave the viewer without the cleared lines.
+    #[test]
+    fn history_counters_clear_and_reset() {
+        let mut term = fed_term(10, 5, 10, b"a\r\nb\r\nc");
+        assert_eq!(term.grid().lines_scrolled_into_history(), 0);
+
+        let mut parser: ansi::Processor = ansi::Processor::new();
+        parser.advance(&mut term, b"\x1b[2J");
+        assert_eq!(term.grid().lines_scrolled_into_history(), 3);
+        let history: Vec<char> = (1..=3).map(|n| term.grid()[Line(-n)][Column(0)].c).collect();
+        assert_eq!(history, ['c', 'b', 'a']);
+
+        parser.advance(&mut term, b"\x1bc");
+        assert_eq!(term.grid().history_size(), 0);
+        assert_eq!(term.grid().history_clears(), 1);
+        assert_eq!(term.grid().lines_scrolled_into_history(), 3);
+
+        parser.advance(&mut term, b"\x1bc");
+        assert_eq!(term.grid().history_clears(), 2);
+    }
 }

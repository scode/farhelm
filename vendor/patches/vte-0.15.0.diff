+        let filler = vec![b'u'; OSC_PAYLOAD_LIMIT];
+        // Each case: the bytes after `ESC ]` before `filler`, those after it,
+        // and the params `osc_overflow` must carry. `filler` alone is the
+        // whole limit, so the limit is hit inside it, or, in the first case,
+        // at the `u` right after it.
+        let cases: [(&[u8], &[u8], &[&[u8]]); 4] = [
+            (b"", b"u;x", &[]),
+            (b"8;", b"", &[b"8"]),
+            (b"8;id=a;", b";more", &[b"8", b"id=a"]),
+            (b"8;id=a;https://e/", b"", &[b"8", b"id=a"]),
+        ];
+        for (before, after, expected) in cases {
+            let mut input = b"\x1b]".to_vec();
+            input.extend_from_slice(before);
+            input.extend_from_slice(&filler);
+            input.extend_from_slice(after);
+            input.extend_from_slice(b"\x1b\\");
+

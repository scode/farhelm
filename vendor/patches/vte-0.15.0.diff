+    // Farhelm patch tests. They run with `cargo test --manifest-path
+    // vendor/vte/Cargo.toml` (vendor/README.md). The emulator's own tests in
+    // the supervisor cover the same caps through the public API.
+
+    /// Spec: `is_ground()` is true exactly between sequences: not inside an
+    /// escape, CSI, OSC or DCS sequence, and not between the bytes of one
+    /// UTF-8 code point.
+    ///
+    /// Why: the supervisor only snapshots an emulator where this holds; a
+    /// snapshot taken anywhere else would lose the parser state the next
+    /// bytes depend on.
+    #[test]
+    fn is_ground_only_between_sequences() {
+        let mut dispatcher = Dispatcher::default();
+        let mut parser = Parser::new();
+        assert!(parser.is_ground());
+
+        // Each step feeds bytes and states whether the parser is now between
+        // sequences.
+        let steps: &[(&[u8], bool)] = &[
+            (b"text", true),
+            (b"\x1b", false),
+            (b"[3", false),
+            (b"1m", true),
+            (b"\xc3", false),
+            (b"\xa9", true),
+            (b"\x1b]2;title", false),
+            (b"\x07", true),
+            (b"\x1bPq", false),
+            (b"#0\x1b\\", true),
+        ];
+        for (bytes, ground) in steps {
+            parser.advance(&mut dispatcher, bytes);
+            assert_eq!(parser.is_ground(), *ground, "after {bytes:?}");
+        }
+    }
+
+    /// Spec: an OSC whose payload is exactly `OSC_PAYLOAD_LIMIT` bytes is
+    /// dispatched whole.
+    ///
+    /// Why: the limit is chosen so that the largest clipboard write xterm.js
+    /// accepted still works; an off-by-one here would break exactly those.
+    #[cfg(feature = "std")]
+    #[test]
+    fn osc_at_payload_limit_is_dispatched() {
+        // `52` and `c` count toward the limit; the `;` separators do not.
+        let data_len = OSC_PAYLOAD_LIMIT - 3;
+        let mut input = b"\x1b]52;c;".to_vec();
+        input.resize(input.len() + data_len, b'A');
+        input.push(0x07);
+
+        let mut dispatcher = Dispatcher::default();
+        let mut parser = Parser::new();
+        parser.advance(&mut dispatcher, &input);
+
+        assert_eq!(dispatcher.dispatched.len(), 1);
+        match &dispatcher.dispatched[0] {
+            Sequence::Osc(params, true) => {
+                assert_eq!(params.len(), 3);
+                assert_eq!(params[2].len(), data_len);
+            },
+            other => panic!("expected an OSC dispatch, got {other:?}"),
+        }
+    }
+
+    /// Spec: an OSC longer than `OSC_PAYLOAD_LIMIT` is never dispatched;
+    /// instead the performer gets one `osc_overflow` with the parameters
+    /// that were complete before the limit. The parser stores no more than
+    /// the limit while the sequence arrives, gives the buffer back as soon as
+    /// it ends, and parses the next sequence as usual. That holds for each
+    /// way an OSC can end (BEL, ST, CAN).
+    ///
+    /// Why: this is the bound that keeps one program's output from growing
+    /// the shared supervisor's memory without limit, and a truncated dispatch
+    /// would hand the embedder corrupt data (half a base64 clipboard payload).
+    #[cfg(feature = "std")]
+    #[test]
+    fn osc_over_payload_limit_is_dropped() {
+        for terminator in [&b"\x07"[..], b"\x1b\\", b"\x18"] {
+            let mut dispatcher = Dispatcher::default();
+            let mut parser = Parser::new();
+
+            parser.advance(&mut dispatcher, b"\x1b]52;c;");
+            parser.advance(&mut dispatcher, &vec![b'A'; OSC_PAYLOAD_LIMIT + 1]);
+            assert_eq!(parser.osc_raw.len(), OSC_PAYLOAD_LIMIT);
+            parser.advance(&mut dispatcher, terminator);
+            assert!(parser.osc_raw.capacity() <= MAX_OSC_RAW, "buffer kept after {terminator:?}");
+            parser.advance(&mut dispatcher, b"\x1b]2;next\x07");
+
+            let oscs: Vec<_> = dispatcher
+                .dispatched
+                .iter()
+                .filter(|seq| matches!(seq, Sequence::Osc(..) | Sequence::OscOverflow(..)))
+                .collect();
+            let bell = terminator == b"\x07";
+            let dropped = Sequence::OscOverflow(vec![b"52".to_vec(), b"c".to_vec()], bell);
+            let next = Sequence::Osc(vec![b"2".to_vec(), b"next".to_vec()], true);
+            assert_eq!(oscs, [&dropped, &next], "after {terminator:?}");
+            assert!(parser.is_ground());
+        }
+    }

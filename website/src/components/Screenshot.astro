---
/**
 * One annotated screenshot of the Farhelm UI, by name (docs/docs-shots/SPEC.md).
 *
 * The images are not in this repository's main history. A published shot is
 * read from the snapshot `website/src/data/docs-shots.json` pins, by its raw
 * GitHub URL; that manifest is written only by `scripts/publish-docs-shots.sh`.
 * A name the manifest does not know fails the build, so a page cannot ship
 * pointing at a shot that was never published.
 *
 * In `astro dev`, a shot captured locally by `scripts/docs-screenshots.sh`
 * (under the gitignored `public/docs-shots-local/`) wins over the published
 * one and is labelled as a local capture. That is what lets a page being
 * drafted show its new or recaptured shots before anything is published. A
 * production build never looks at local captures, so it shows exactly what
 * the deployed site will.
 *
 * Shots are captured at a device scale of 2 and shown at half their pixel
 * size, so they stay crisp on high-density screens.
 */
import { existsSync, readFileSync, statSync } from 'node:fs';
import path from 'node:path';
import manifest from '../data/docs-shots.json';

interface Props {
  /** `<page>/<shot>`, the name the capture gave it (e2e/docs-shots/<page>.spec.ts). */
  name: string;
  /** What the shot shows, naming the control it points at, for readers who cannot see it. */
  alt: string;
}

/** The capture's device scale factor (docs/docs-shots/scenario.json5). */
const SCALE = 2;

const { name, alt } = Astro.props;
const shots = manifest.shots as Record<string, { width: number; height: number }>;

let src: string;
let width: number;
let height: number;
let local = false;
// The dev server runs from website/ (scripts/preview.sh and the package
// scripts both start it there).
const localFile = path.join(process.cwd(), 'public/docs-shots-local', `${name}.png`);
if (import.meta.env.DEV && existsSync(localFile)) {
  // A PNG's pixel size sits in its IHDR chunk, at bytes 16-23.
  const header = readFileSync(localFile).subarray(16, 24);
  width = header.readUInt32BE(0);
  height = header.readUInt32BE(4);
  // The modification time busts the browser's cache after a recapture.
  src = `/docs-shots-local/${name}.png?v=${Math.floor(statSync(localFile).mtimeMs)}`;
  local = true;
} else {
  const shot = shots[name];
  // A manifest without its capture record predates bulk regeneration or was
  // written by hand; either way the next refresh could not tell what changed
  // since these shots were taken (docs/docs-shots/SPEC.md, "Refreshing").
  if (!(manifest as { captured_from?: string }).captured_from) {
    throw new Error(
      'website/src/data/docs-shots.json has no captured_from: run scripts/docs-screenshots.sh, then scripts/publish-docs-shots.sh',
    );
  }
  if (!shot || !manifest.commit) {
    throw new Error(
      `no published screenshot named "${name}": capture it with scripts/docs-screenshots.sh, ` +
        `then publish it with scripts/publish-docs-shots.sh`,
    );
  }
  src = `${manifest.base}/${manifest.commit}/${name}.png`;
  width = shot.width;
  height = shot.height;
}
---

<figure class="farhelm-screenshot">
  <img
    src={src}
    alt={alt}
    width={Math.round(width / SCALE)}
    height={Math.round(height / SCALE)}
    loading="lazy"
    decoding="async"
  />
  {local && <figcaption>local capture, not yet published</figcaption>}
</figure>

<style>
  .farhelm-screenshot {
    margin: 1.25rem 0;
  }
  .farhelm-screenshot img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .farhelm-screenshot figcaption {
    margin-top: 0.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-orange-high);
  }
</style>

{
  "markdown": {
    "lineWidth": 120,
    "newLineKind": "lf",
    "textWrap": "always"
  },
  "excludes": [
    "**/*-lock.json",
    "**/bun.lock",
    "target/**",
    "lore/**",
    "CHANGELOG.md",
    "releasing/changelog.d/*.md",
    "releasing/drafts/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm"
  ]
}

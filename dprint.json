{
  "markdown": {
    "lineWidth": 120,
    "newLineKind": "lf",
    "textWrap": "always",
    "wrapCodeSpans": false
  },
  "excludes": [
    "**/*-lock.json",
    "**/bun.lock",
    "target/**",
    "lore/**",
    "plans/queue/INDEX.md",
    "plans/REPORTS.md",
    "CHANGELOG.md",
    "releasing/changelog.d/*.md",
    "releasing/drafts/**"
  ],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0"
  ]
}

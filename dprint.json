{
  "markdown": {
    "lineWidth": 120,
    "newLineKind": "lf",
    "textWrap": "always",
    "wrapCodeSpans": false
  },
  "excludes": [
    "**/*-lock.json",
    "**/bun.lock",
    "target/**",
    "lore/**",
    "plans/queue/INDEX.md",
    "plans/REPORTS.md",
    "CHANGELOG.md",
    "releasing/changelog.d/*.md",
    "vendor/alacritty_terminal/**",
    "vendor/vte/**",
    "vendor/gpui-pre/**",
    "vendor/gpui-pre-linux/**",
    "vendor/gpui-pre-wgpu/**",
    "vendor/gpui-pre-macos/**",
    "vendor/gpui-agent/**",
    "crates/gui/farhelm-grid-model/tests/fixtures/links-oracle.json"
  ],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0"
  ]
}
